---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { siteConfig } from "~/site.config";

interface Props extends HTMLAttributes<"time"> {
  date: Date;
  hideIcon?: boolean;
}

const { date, hideIcon, class: className } = Astro.props;

const day = date.getDate();
const month = date.toLocaleString(siteConfig.locale, { month: "long" });
const year = date.getFullYear();

const formattedDate = `${day} ${month} ${year}`;
---

<time
  class:list={["flex items-center", !hideIcon ? "gap-1" : "", className]}
  datetime={date.toISOString()}
  lang="en-GB"
>
  {
    !hideIcon && (
      <Icon
        name="material-symbols:calendar-today-outline"
        height={21}
        width={21}
        class="self-center"
      />
    )
  }

  <span class="p-1 leading-none">{formattedDate}</span>
</time>
